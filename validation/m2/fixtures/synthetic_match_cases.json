    {
      "case_id": "fully_symmetric_ambiguity",
      "description": "Symmetric square distances: (P0,C0)+(P1,C1) == (P0,C1)+(P1,C0). Both links marked ambiguous=true and substitutability=tied",
      "mode": "absolute",
      "weights": [
        1.0,
        1.0
      ],
      "threshold": 5.0,
      "prev_scenarios": [
        {
          "cluster_id": 0,
          "mean_features": [
            0.0,
            0.0
          ]
        },
        {
          "cluster_id": 1,
          "mean_features": [
            2.0,
            2.0
