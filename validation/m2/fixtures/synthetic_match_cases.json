            "reason": "no_candidate_within_threshold"
          },
          {
            "cluster_id": 1,
            "reason": "no_candidate_within_threshold"
          }
        ],
        "unmatched_curr": [
          {
            "cluster_id": 0,
            "reason": "no_candidate_within_threshold"
          },
          {
            "cluster_id": 1,
            "reason": "no_candidate_within_threshold"
          }
        ]
      }
    },
    {
      "case_id": "exact_threshold_boundary",
      "description": "Distance exactly equals threshold (d == tau); must be included in feasible set",
