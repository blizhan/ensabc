      "expected": {
        "matched_count": 2,
        "weighted_distance_sum": 1.0,
        "links": [
          {
            "prev_cluster_id": 0,
            "curr_cluster_id": 0,
            "distance_k": 0.5,
            "substitutability": "same_count",
            "ambiguous": false
          },
          {
            "prev_cluster_id": 1,
            "curr_cluster_id": 1,
            "distance_k": 0.5,
            "substitutability": "same_count",
            "ambiguous": false
          }
        ],
        "unmatched_prev": [],
        "unmatched_curr": [
          {
            "cluster_id": 2,
            "reason": "not_selected_in_global_optimum"
          }
        ]
      }
    },
