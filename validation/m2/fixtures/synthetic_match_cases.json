{
  "schema_version": "m2.synthetic-tasks.v1",
  "description": "Comprehensive synthetic match test cases for M2 matching core and SQL adapter",
  "positive_cases": [
    {
      "case_id": "threshold_counterexample_2x2",
      "description": "Candidate distances [[0, 4], [4, 6]] with tau=5.0 gives 2 links of distance 4.0 instead of greedy 1 link of distance 0.0",
      "mode": "absolute",
      "weights": [
        1.0,
        1.0
      ],
      "threshold": 5.0,
      "prev_scenarios": [
        {
          "cluster_id": 0,
          "mean_features": [
            0.0,
            0.0
          ]
        },
        {
          "cluster_id": 1,
          "mean_features": [
            3.468626966596886,
            -4.4686269665968865
          ]
        }
      ],
      "curr_scenarios": [
        {
          "cluster_id": 0,
          "mean_features": [
            0.0,
            0.0
          ]
        },
        {
          "cluster_id": 1,
          "mean_features": [
            4.0,
            4.0
          ]
        }
      ],
      "expected": {
        "matched_count": 2,
        "weighted_distance_sum": 8.0,
        "links": [
          {
            "prev_cluster_id": 0,
            "curr_cluster_id": 1,
            "distance_k": 4.0,
            "substitutability": "count_drop",
            "ambiguous": false
          },
          {
            "prev_cluster_id": 1,
            "curr_cluster_id": 0,
            "distance_k": 4.0,
            "substitutability": "count_drop",
            "ambiguous": false
          }
        ],
        "unmatched_prev": [],
        "unmatched_curr": []
      }
    },
    {
      "case_id": "all_exceed_threshold",
      "description": "All pairwise distances exceed threshold; returns 0 links as valid success",
      "mode": "absolute",
      "weights": [
        1.0,
        1.0
      ],
      "threshold": 1.0,
      "prev_scenarios": [
        {
          "cluster_id": 0,
