    {
      "case_id": "rectangular_2_to_3_competition",
      "description": "2 prev scenarios vs 3 curr scenarios; one curr scenario left unmatched due to global competition",
      "mode": "absolute",
      "weights": [
        1.0
      ],
      "threshold": 10.0,
      "prev_scenarios": [
        {
          "cluster_id": 0,
          "mean_features": [
            0.0
          ]
        },
        {
          "cluster_id": 1,
          "mean_features": [
            10.0
          ]
        }
      ],
      "curr_scenarios": [
        {
          "cluster_id": 0,
          "mean_features": [
            0.5
          ]
        },
        {
          "cluster_id": 1,
          "mean_features": [
            9.5
          ]
        },
        {
          "cluster_id": 2,
          "mean_features": [
            5.0
          ]
        }
