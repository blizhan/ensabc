__pycache__
*.py[cod]
tutorial/data
# The top-level data directory only. The pattern is anchored so that it does
# not also match the nested `spikes/data/` directory, which holds the
# planning-time extraction tool and must stay in version control.
/data/

# Rust build outputs
/target/
**/*.rs.bk

# M0 run evidence. The evidence bundle is regenerated by
# `validation/m0/run_m0_gate.py`; only the run identity and the report
# summary are worth keeping in version control.
/artifacts/m0/

# The derived M0 sample payload is not committed: the redistribution
# permission for the re-gridded WeatherBench 2 derivative is unresolved.
# The manifest, the source generation evidence and the recovery procedure are
# committed, so a reviewer can rebuild the identical payload with
# `validation/m0/extract_sample.py --rebuild --from-source`.
#
# Only the two *data* files of the planning spike are excluded. The spike's
# extraction tool and its findings are planning evidence and stay in version
# control, because the recovery path refers to them.
/validation/m0/fixtures/real_ifs_ens_20200101_t2m_data.json
/specs/001-m0-baseline-validation/spikes/data/sample.csv
/specs/001-m0-baseline-validation/spikes/data/sample.json
